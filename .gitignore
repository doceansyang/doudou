# ---------------------------------------------------------------------------
# JinyuTV 本地内容（不进仓库）
#
# 说明：下面这些是「本机开发 / 测试产物」，不是项目的一部分。
#   注意 `/assets/` 开头的斜杠是必须的 —— 它只匹配仓库根目录下的 assets/，
#   不能写成 `assets/`，否则会把 packages/assets/、apps/web/src/assets/ 也一起忽略掉。
# ---------------------------------------------------------------------------
/.rebrand-backup/
/.api-rebrand-backup/
/.tfrouter-backup/
/assets/
/scripts/_out/
/tools/_dl/
*.orig
*.bak
*.bak2
*.bak3
*.bak-*
*.prebuild
*.manual

# 上游的 GitHub Actions（本项目的构建/发布走本地脚本 toonflow/scripts/*，
# 不用 Actions；而且 gh 令牌没有 workflow 权限，保留会被 GitHub 拒绝推送）
/.github/workflows/

# 授权签发私钥（绝不能进仓库；正常也不在这里，仅作兜底）
*.jwk
*.pem
scripts/license/private*

# 本机授权文件（每台机器自己激活后生成，不该进仓库）
/data/license.json

# 截图宿主的临时产物
scripts/_shot-license.cs
scripts/_out/_shot-license.exe
scripts/_ctor_old.txt
scripts/_ctor_new.txt
scripts/_c_old.txt
scripts/_c_new.txt
scripts/_*.txt
scripts/launcher.cs.bak-*

# 含服务器凭据 / 服务器地址的部署脚本，绝不入库
# （通用部署方案见 tools/plugin-forwarder/deploy/，那份是可公开的、不含凭据）
/scripts/_probe-server-check.py
/scripts/_deploy-plugin-forwarder.py
/scripts/_deploy-forwarder-fix.py
/scripts/_deploy-path-prefix.py
/scripts/_deploy-token.py
/scripts/_deploy-update-host.py
/scripts/_server.py

# 本地构建与探针产物
/_build-cache/
/apps/scripts/_out/

# 浏览器扩展的签名私钥（只在本机保留：泄露=别人可冒用同一扩展 ID）
/tools/*.pem

# ---------------------------------------------------------------------------
# 本机开发产物：探针 / 截图 / 调试脚本（2026-10-14 清理）
#
# 这些是本机调试用的一次性脚本（`_probe-*` / `_shot-*` / `_diag-*` / `_verify-*`）
# 与前端覆盖预览工具链，不属于产品，历史上曾被误提交。
# 这里只**停止跟踪**，本机文件仍然保留。
# ---------------------------------------------------------------------------
/scripts/_*
/apps/web/_overlay-preview/
