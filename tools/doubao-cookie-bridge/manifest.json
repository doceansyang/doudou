{
  "manifest_version": 3,
  "name": "JinyuTV 豆包账号桥",
  "version": "0.1.0",
  "description": "把本机浏览器里已登录的豆包账号同步到 JinyuTV。数据只走本机 127.0.0.1，不上传任何服务器。",
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": [
    "https://*.doubao.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "同步豆包账号到 JinyuTV"
  }
}
